# ===== LLM =====
# "ollama" (local, gratuit) ou "openai"
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ===== Embeddings =====
# "huggingface" (local) ou "openai". Changer de modele = re-ingerer (dimension differente).
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# ===== Reranker / retrieval =====
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RELEVANCE_THRESHOLD=0.15
HYBRID_SEARCH=true
TOP_N=5

# ===== PostgreSQL (docker compose up -d db) =====
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
APP_DATABASE_URL=postgresql+psycopg://rag_app:rag_app@localhost:5432/rag
READER_DATABASE_URL=postgresql+psycopg://rag_reader:rag_reader@localhost:5432/rag

# ===== LangSmith (traces + evaluation) =====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=rag-v2

# ===== Langfuse (traces, tokens, couts par question) =====
# Compte gratuit sur https://cloud.langfuse.com (region UE) -> Settings -> API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ===== API =====
# API_KEY=change-me
